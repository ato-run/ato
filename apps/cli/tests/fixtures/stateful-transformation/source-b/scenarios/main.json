{
  "schema": "ato.scenario/1",
  "verifier_version": 1,
  "isolation": {
    "fresh_instance": true,
    "network": "candidate-only"
  },
  "limits": {
    "step_timeout_ms": 5000,
    "total_timeout_ms": 60000,
    "max_body_bytes": 1048576
  },
  "steps": [
    {
      "id": "login",
      "request": {
        "method": "POST",
        "path": "/login",
        "body_b64": "e30="
      },
      "expect": {
        "status": 200
      }
    },
    {
      "id": "invalid-create",
      "request": {
        "method": "POST",
        "path": "/items",
        "body_b64": "eyJuYW1lIjoiIiwicXVhbnRpdHkiOi0xfQ=="
      },
      "expect": {
        "status": 400
      }
    },
    {
      "id": "create",
      "request": {
        "method": "POST",
        "path": "/items",
        "body_b64": "eyJuYW1lIjoiZmlyc3QiLCJxdWFudGl0eSI6Mn0="
      },
      "expect": {
        "status": 201,
        "json": [
          {
            "pointer": "/id",
            "exists": true
          }
        ]
      },
      "capture": [
        {
          "name": "item",
          "json_pointer": "/id"
        }
      ]
    },
    {
      "id": "read-created",
      "request": {
        "method": "GET",
        "path": "/items/${item}"
      },
      "expect": {
        "status": 200,
        "json": [
          {
            "pointer": "/name",
            "equals": "first"
          },
          {
            "pointer": "/quantity",
            "equals": 2
          }
        ]
      }
    },
    {
      "id": "update",
      "request": {
        "method": "PUT",
        "path": "/items/${item}",
        "body_b64": "eyJuYW1lIjoidXBkYXRlZCIsInF1YW50aXR5IjozfQ=="
      },
      "expect": {
        "status": 200,
        "body_digest": "sha256:0c9f018a67e908c267990677b8553afcbc2c3c996ed1fae981d76f71428f1638"
      }
    },
    {
      "id": "unauthorized-read",
      "request": {
        "method": "GET",
        "path": "/items/${item}",
        "cookies": "cleared"
      },
      "expect": {
        "status": 401
      }
    },
    {
      "id": "delete",
      "request": {
        "method": "DELETE",
        "path": "/items/${item}"
      },
      "expect": {
        "status": 204
      }
    },
    {
      "id": "read-after-delete",
      "request": {
        "method": "GET",
        "path": "/items/${item}"
      },
      "expect": {
        "status": 404
      }
    }
  ]
}

#!/bin/sh
# Starts the verifier's browser with nothing of the helper's.
#
# Run inside the verifier sandbox as Stagehand's browser executable. The
# helper holds model keys (read from a file descriptor, never from the
# environment); the browser renders an untrusted application. So the browser
# gets:
#   - an empty environment (env -i) plus HOME, TMPDIR, PATH and LANG, and
#   - its own PID namespace (a nested bubblewrap), in which the helper's
#     process — and its /proc entries — do not exist.
# Its filesystem is the verifier sandbox's, unchanged. If bubblewrap cannot
# nest here, the browser does not start: there is no fallback beside the
# helper.
set -eu
real="${ATO_BROWSER_CHROME_REAL:?the verifier sandbox names the browser}"
home="${HOME:-/scratch/home}"
tmp="${TMPDIR:-/scratch/tmp}"
exec /usr/bin/env -i HOME="$home" TMPDIR="$tmp" PATH=/usr/bin:/bin LANG=C.UTF-8 \
  /usr/bin/bwrap --unshare-pid --die-with-parent --dev-bind / / --proc /proc \
  -- "$real" "$@"

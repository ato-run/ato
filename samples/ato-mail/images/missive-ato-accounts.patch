+
+    #[derive(Clone)]
+    struct MockState {
+        responses: Arc<Mutex<VecDeque<Value>>>,
+        received: Arc<Mutex<Vec<Value>>>,
+    }
+
+    async fn mock_handler(State(state): State<MockState>, request: Request) -> Response {
+        let (_parts, body) = request.into_parts();
+        let bytes = axum::body::to_bytes(body, usize::MAX)
+            .await
+            .unwrap_or_default();
+        let request_value: Value = serde_json::from_slice(&bytes).unwrap_or(Value::Null);
+        state.received.lock().unwrap().push(request_value);
+        let response = state
+            .responses
+            .lock()
+            .unwrap()
+            .pop_front()
+            .unwrap_or(Value::Null);
+        (StatusCode::OK, Json(response)).into_response()
+    }
+
+    /// A JMAP server on loopback that records request bodies and answers with a
+    /// script of responses, one per request.
+    struct MockJmap {
+        endpoint: JmapEndpoint,
+        received: Arc<Mutex<Vec<Value>>>,
+    }
+
+    impl MockJmap {
+        async fn start(responses: Vec<Value>) -> Self {
+            let state = MockState {
+                responses: Arc::new(Mutex::new(VecDeque::from(responses))),
+                received: Arc::new(Mutex::new(Vec::new())),
+            };
+            let received = Arc::clone(&state.received);
+            let app = Router::new().fallback(mock_handler).with_state(state);
+            let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+            let address = listener.local_addr().unwrap();
+            tokio::spawn(async move {
+                let _ = axum::serve(listener, app).await;
+            });
+            Self {
+                endpoint: JmapEndpoint {
+                    api_url: format!("http://{address}/jmap"),
+                    account_id: "u1".to_string(),
+                    headers: HeaderMap::new(),
+                },
+                received,
+            }
+        }
+
+        fn requests(&self) -> Vec<Value> {
+            self.received.lock().unwrap().clone()
+        }
+    }
+
+    fn method_ok(method: &str, args: Value, call_id: &str) -> Value {
+        json!({"methodResponses": [[method, args, call_id]], "sessionState": "s1"})
+    }
+
+    fn method_error(kind: &str, call_id: &str) -> Value {
+        json!({
+            "methodResponses": [["error", {"type": kind, "description": "test error"}, call_id]],
+            "sessionState": "s1",
+        })
+    }
+
+    async fn response_json(response: Response) -> (StatusCode, Value) {
+        let status = response.status();
+        let bytes = axum::body::to_bytes(response.into_body(), usize::MAX)
+            .await
+            .unwrap();
+        let value = serde_json::from_slice(&bytes).unwrap();
+        (status, value)
+    }

+/// Body of `PUT /__ato/accounts/{account}`.
+#[derive(Debug, Default, Deserialize)]
+pub struct ProvisionAccountBody {
+    #[serde(default)]
+    pub display_name: Option<String>,
+}
+
+/// Body of `POST /__ato/accounts/{account}/app-passwords`.
+#[derive(Debug, Deserialize)]
+pub struct CreateAppPasswordBody {
+    pub description: String,
+    #[serde(default)]
+    pub expires_at: Option<String>,
+}
+
+/// `PUT /__ato/accounts/{account}` — create the mailbox (idempotent).
+pub async fn provision_account(
+    State(state): State<AppState<MissiveConfig>>,
+    Extension(identity): Extension<AtoIdentityState>,
+    Path(account): Path<String>,
+    body: std::result::Result<Json<ProvisionAccountBody>, JsonRejection>,
+) -> Response {
+    let identity = match enabled_identity(&identity) {
+        Ok(identity) => identity,
+        Err(error) => return error.into_response(),
+    };
+    let account = match provisionable_account(&identity, &account) {
+        Ok(account) => account,
+        Err(error) => return error.into_response(),
+    };
+    let Ok(Json(body)) = body else {
+        return AccountsError::InvalidRequest.into_response();
+    };
+
+    let jmap_url = state.config().custom.jmap_url.clone();
+    let endpoint = match connect_provisioner(&identity, &jmap_url).await {
+        Ok(endpoint) => endpoint,
+        Err(error) => return error.into_response(),
+    };
+    match provision_account_in(&endpoint, &account, body.display_name.as_deref()).await {
+        Ok(outcome) => outcome.into_response(),
+        Err(error) => error.into_response(),
+    }
+}
+
+/// `GET /__ato/accounts/{account}/app-passwords`.
+pub async fn list_app_passwords(
+    State(state): State<AppState<MissiveConfig>>,
+    Extension(identity): Extension<AtoIdentityState>,
+    Path(account): Path<String>,
+    headers: HeaderMap,
+) -> Response {
+    let identity = match enabled_identity(&identity) {
+        Ok(identity) => identity,
+        Err(error) => return error.into_response(),
+    };
+    let account = match impersonated_account(&identity, &headers, &account) {
+        Ok(account) => account,
+        Err(error) => return error.into_response(),
+    };
+
+    let jmap_url = state.config().custom.jmap_url.clone();
+    let endpoint = match connect_account(&identity, &jmap_url, account.address()).await {
+        Ok(endpoint) => endpoint,
+        Err(error) => return error.into_response(),
+    };
+    match list_app_passwords_in(&endpoint).await {
+        Ok(list) => list.into_response(),
+        Err(error) => error.into_response(),
+    }
+}
+
+/// `POST /__ato/accounts/{account}/app-passwords`.
+pub async fn create_app_password(
+    State(state): State<AppState<MissiveConfig>>,
+    Extension(identity): Extension<AtoIdentityState>,
+    Path(account): Path<String>,
+    headers: HeaderMap,
+    body: std::result::Result<Json<CreateAppPasswordBody>, JsonRejection>,
+) -> Response {
+    let identity = match enabled_identity(&identity) {
+        Ok(identity) => identity,
+        Err(error) => return error.into_response(),
+    };
+    let account = match impersonated_account(&identity, &headers, &account) {
+        Ok(account) => account,
+        Err(error) => return error.into_response(),
+    };
+    let Ok(Json(body)) = body else {
+        return AccountsError::InvalidRequest.into_response();
+    };
+    if let Err(error) = validate_description(&body.description) {
+        return error.into_response();
+    }
+    if let Some(expires_at) = body.expires_at.as_deref()
+        && let Err(error) = validate_expires_at(expires_at)
+    {
+        return error.into_response();
+    }
+
+    let jmap_url = state.config().custom.jmap_url.clone();
+    let endpoint = match connect_account(&identity, &jmap_url, account.address()).await {
+        Ok(endpoint) => endpoint,
+        Err(error) => return error.into_response(),
+    };
+    match create_app_password_in(&endpoint, &body.description, body.expires_at.as_deref()).await {
+        Ok(created) => created.into_response(),
+        Err(error) => error.into_response(),
+    }
+}
+
+/// `DELETE /__ato/accounts/{account}/app-passwords/{id}`.
+pub async fn destroy_app_password(
+    State(state): State<AppState<MissiveConfig>>,
+    Extension(identity): Extension<AtoIdentityState>,
+    Path((account, id)): Path<(String, String)>,
+    headers: HeaderMap,
+) -> Response {
+    let identity = match enabled_identity(&identity) {
+        Ok(identity) => identity,
+        Err(error) => return error.into_response(),
+    };
+    let account = match impersonated_account(&identity, &headers, &account) {
+        Ok(account) => account,
+        Err(error) => return error.into_response(),
+    };
+
+    let jmap_url = state.config().custom.jmap_url.clone();
+    let endpoint = match connect_account(&identity, &jmap_url, account.address()).await {
+        Ok(endpoint) => endpoint,
+        Err(error) => return error.into_response(),
+    };
+    match destroy_app_password_in(&endpoint, &id).await {
+        Ok(()) => StatusCode::NO_CONTENT.into_response(),
+        Err(error) => error.into_response(),
+    }
+}
+
+/// `DELETE /__ato/accounts/{account}/app-passwords` — revoke all of them.
+pub async fn destroy_all_app_passwords(
+    State(state): State<AppState<MissiveConfig>>,
+    Extension(identity): Extension<AtoIdentityState>,
+    Path(account): Path<String>,
+    headers: HeaderMap,
+) -> Response {
+    let identity = match enabled_identity(&identity) {
+        Ok(identity) => identity,
+        Err(error) => return error.into_response(),
+    };
+    let account = match impersonated_account(&identity, &headers, &account) {
+        Ok(account) => account,
+        Err(error) => return error.into_response(),

+//! Ato account provisioning and self-service app passwords.
+//!
+//! Ato's Coordinator is the only caller of these routes: Ato's app gateway
+//! never forwards a client request whose path starts with `/__ato/` to an OCI
+//! app, so the paths below are unreachable from the browser. They implement the
+//! mailbox side of Ato's account lifecycle:
+//!
+//! - `PUT /__ato/accounts/{account}` creates the Stalwart account. It is
+//!   idempotent: an account that already exists is a success. The mailbox
+//!   password is generated here and never leaves this process — people sign in
+//!   through the Ato gateway (see `ato_identity`), not with that password.
+//! - `GET|POST /__ato/accounts/{account}/app-passwords` list and issue
+//!   Stalwart app passwords for IMAP/SMTP clients, which cannot use the
+//!   gateway.
+//! - `DELETE /__ato/accounts/{account}/app-passwords[/{id}]` revoke one or all
+//!   app passwords, used when Ato suspends the account.
+//!
+//! The app-password routes act as the account itself: Missive signs in to JMAP
+//! as `<account>%<impersonator>` with the impersonator's password and calls
+//! Stalwart's `x:AppPassword` methods. Provisioning acts as the impersonator
+//! principal itself, which must hold `sysAccountCreate` (and `sysDomainGet`
+//! when it may look domains up). The routes stay unregistered (404) unless
+//! `[ato_identity]` is configured, and every response is JSON.
+
+use std::sync::Arc;
+
+use acton_service::prelude::*;
+use axum::Json;
+use axum::extract::rejection::JsonRejection;
+use axum::http::{HeaderMap, StatusCode};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+
+use crate::ato_identity::{AtoIdentity, AtoIdentityState, validate_account};
+use crate::config::MissiveConfig;
+use crate::error::{JmapErrorKind, MissiveError};
+use crate::jmap::{self, JmapUrl};
+use crate::jmap_raw::{self, JmapEndpoint};
+
+/// JMAP capabilities these routes use: the core capability every JMAP request
+/// must list, and Stalwart's custom one, which carries `x:Account`,
+/// `x:Domain` and `x:AppPassword`.
+const USING_STALWART: &[&str] = &["urn:ietf:params:jmap:core", "urn:stalwart:jmap"];
+
+/// Random bytes behind a generated mailbox password.
+const RANDOM_PASSWORD_BYTES: usize = 32;
+
+/// Longest app-password description the contract accepts, in characters.
+const MAX_DESCRIPTION_CHARS: usize = 80;
+
+// ---------------------------------------------------------------------------
+// Path account
+// ---------------------------------------------------------------------------
+
+/// A validated account address from the `{account}` path segment.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Account {
+    address: String,
+}
+
+impl Account {
+    /// The full address, as it appeared in the URL (percent-decoded).
+    pub fn address(&self) -> &str {
+        &self.address
+    }
+
+    /// The local part (before the single `@`).
+    fn local_part(&self) -> &str {
+        self.address.split_once('@').map_or(&self.address, |(local, _)| local)
+    }
+
+    /// The domain (after the single `@`).
+    fn domain(&self) -> &str {
+        self.address.split_once('@').map_or("", |(_, domain)| domain)
+    }
+}
+
+/// Validate the `{account}` path segment.
+///
+/// The address must have exactly one `@` and no `%` (Stalwart uses `%` to
+/// encode master-user impersonation); the same printable-ASCII and length rules
+/// as the identity header apply. Anything else is `400 invalid_account`.
+pub fn parse_account(value: &str) -> std::result::Result<Account, AccountsError> {
+    validate_account(value).map_err(|_| AccountsError::InvalidAccount)?;
+    Ok(Account {
+        address: value.to_owned(),
+    })
+}
+
+/// Refuse an account whose domain is not in `[ato_identity] provision_domains`.
+pub fn ensure_domain_provisioned(
+    provision_domains: &[String],
+    account: &Account,
+) -> std::result::Result<(), AccountsError> {
+    if provision_domains
+        .iter()
+        .any(|domain| domain.eq_ignore_ascii_case(account.domain()))
+    {
+        Ok(())
+    } else {
+        Err(AccountsError::DomainNotProvisioned)
+    }
+}
+
+/// Require the configured account header to name the same account as the path.
+///
+/// The gateway sets the header for the signed-in person; a request without it or
+/// naming another account must not touch `{account}`'s app passwords.
+pub fn ensure_account_header(
+    identity: &AtoIdentity,
+    headers: &HeaderMap,
+    account: &Account,
+) -> std::result::Result<(), AccountsError> {
+    let Some(value) = headers.get(identity.header()) else {
+        return Err(AccountsError::AccountMismatch);
+    };
+    let Ok(value) = value.to_str() else {
+        return Err(AccountsError::AccountMismatch);
+    };
+    if value == account.address() {
+        Ok(())
+    } else {
+        Err(AccountsError::AccountMismatch)
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Errors
+// ---------------------------------------------------------------------------
+
+/// Everything these routes answer that is not a success.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum AccountsError {
+    /// The route is not enabled (no `[ato_identity]`).
+    NotFound,
+    /// The `{account}` path segment is not a usable address.
+    InvalidAccount,
+    /// The JSON body is missing or malformed.
+    InvalidRequest,
+    /// `description` is empty or longer than 80 characters.
+    InvalidDescription,
+    /// `expires_at` is not an RFC 3339 timestamp.
+    InvalidExpiresAt,
+    /// The account's domain is not in `provision_domains`.
+    DomainNotProvisioned,
+    /// The account header does not name the path account.
+    AccountMismatch,
+    /// Stalwart answered with an error. `detail` is its JMAP error type.
+    Provider { detail: String },
+    /// The process could not generate a password or another local failure.
+    Internal,
+}
+
+impl std::fmt::Display for AccountsError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::NotFound => write!(f, "route not enabled"),
+            Self::InvalidAccount => write!(f, "invalid account"),
+            Self::InvalidRequest => write!(f, "invalid request"),
+            Self::InvalidDescription => write!(f, "invalid app-password description"),
+            Self::InvalidExpiresAt => write!(f, "invalid app-password expiry"),
+            Self::DomainNotProvisioned => write!(f, "domain not provisioned"),
+            Self::AccountMismatch => write!(f, "account header does not match the path"),
+            Self::Provider { detail } => write!(f, "mail server error: {detail}"),
+            Self::Internal => write!(f, "internal error"),
+        }
+    }
+}
+
+impl std::error::Error for AccountsError {}
+
+impl IntoResponse for AccountsError {
+    fn into_response(self) -> Response {
+        let (status, body) = match &self {
+            Self::NotFound => (StatusCode::NOT_FOUND, json!({"error": "not_found"})),
+            Self::InvalidAccount => (StatusCode::BAD_REQUEST, json!({"error": "invalid_account"})),
+            Self::InvalidRequest => (StatusCode::BAD_REQUEST, json!({"error": "invalid_request"})),
+            Self::InvalidDescription => (
+                StatusCode::BAD_REQUEST,
+                json!({"error": "invalid_description"}),
+            ),
+            Self::InvalidExpiresAt => {
+                (StatusCode::BAD_REQUEST, json!({"error": "invalid_expires_at"}))
+            }
+            Self::DomainNotProvisioned => (
+                StatusCode::FORBIDDEN,
+                json!({"error": "domain_not_provisioned"}),
+            ),
+            Self::AccountMismatch => (StatusCode::FORBIDDEN, json!({"error": "account_mismatch"})),
+            Self::Provider { detail } => {
+                // The detail is Stalwart's JMAP error type: no credentials, no
+                // generated secret ever passes through here.
+                warn!("[ato_accounts] mail server error: {detail}");
+                (
+                    StatusCode::BAD_GATEWAY,
+                    json!({"error": "provider_error", "detail": detail}),
+                )
+            }
+            Self::Internal => (
+                StatusCode::INTERNAL_SERVER_ERROR,
+                json!({"error": "internal_error"}),
+            ),
+        };
+        (status, Json(body)).into_response()
+    }
+}
+
+fn provider_invalid_response() -> AccountsError {
+    AccountsError::Provider {
+        detail: "invalid_response".to_string(),
+    }
+}
+
+/// Turn a Missive/JMAP transport failure into `502 provider_error`.
+///
+/// Stalwart's method-level errors keep their JMAP type (see
+/// `method_response`); failures below the JMAP layer have no error type, so
+/// they use a stable slug instead of a free-form message.
+fn provider_from_error(error: &MissiveError) -> AccountsError {
+    let detail = match error {
+        MissiveError::AuthFailed => "auth_failed",
+        MissiveError::Jmap(JmapErrorKind::ConnectionFailed { .. }) => "connection_failed",
+        MissiveError::Jmap(JmapErrorKind::QueryFailed { .. }) => "invalid_response",
+        _ => "transport_error",
+    };
+    AccountsError::Provider {
+        detail: detail.to_string(),
+    }
+}
+
+// ---------------------------------------------------------------------------
+// JMAP plumbing
+// ---------------------------------------------------------------------------
+
+fn build_request(endpoint: &JmapEndpoint, method: &str, args: Value, call_id: &str) -> Value {
+    jmap_raw::build_jmap_request(
+        &endpoint.account_id,
+        USING_STALWART,
+        vec![(method, args, call_id)],
+    )
+}
+
+async fn call(
+    endpoint: &JmapEndpoint,
+    method: &str,
+    args: Value,
+    call_id: &str,
+) -> std::result::Result<Value, AccountsError> {
+    let request = build_request(endpoint, method, args, call_id);
+    let response = jmap_raw::send_request(endpoint, &request)
+        .await
+        .map_err(|error| provider_from_error(&error))?;
+    method_response(&response, call_id)
+}
+
+/// Return the arguments of `call_id`'s method response, or Stalwart's JMAP
+/// error type as `provider_error`.
+fn method_response(
+    response: &Value,
+    call_id: &str,
+) -> std::result::Result<Value, AccountsError> {
+    let calls = response["methodResponses"]
+        .as_array()
+        .ok_or_else(provider_invalid_response)?;
+    for call in calls {
+        let Some(call) = call.as_array() else {
+            continue;
+        };
+        if call.len() < 3 || call[2].as_str() != Some(call_id) {
+            continue;
+        }
+        if call[0].as_str() == Some("error") {
+            let detail = call[1]["type"].as_str().unwrap_or("unknown");
+            return Err(AccountsError::Provider {
+                detail: detail.to_string(),
+            });
+        }
+        return Ok(call[1].clone());
+    }
+    Err(provider_invalid_response())
+}
+
+fn is_already_exists(error: &serde_json::Map<String, Value>) -> bool {
+    let kind = error.get("type").and_then(Value::as_str).unwrap_or_default();
+    if kind.eq_ignore_ascii_case("alreadyExists") || kind.eq_ignore_ascii_case("duplicate") {
+        return true;
+    }
+    // Stalwart's SetError type for a duplicate principal is not part of the JMAP
+    // standard, so accept the standard wording as well.
+    let description = error
+        .get("description")
+        .and_then(Value::as_str)
+        .unwrap_or_default()
+        .to_ascii_lowercase();
+    description.contains("already exists") || description.contains("already in use")
+}
+
+fn is_not_found(error: &serde_json::Map<String, Value>) -> bool {
+    let kind = error.get("type").and_then(Value::as_str).unwrap_or_default();
+    kind.eq_ignore_ascii_case("notFound") || kind.eq_ignore_ascii_case("not_found")
+}
+
+fn set_not_created<'a>(
+    data: &'a Value,
+    id: &str,
+) -> Option<&'a serde_json::Map<String, Value>> {
+    data["notCreated"][id].as_object()
+}
+
+fn set_destroyed(data: &Value, id: &str) -> bool {
+    data["destroyed"]
+        .as_array()
+        .is_some_and(|ids| ids.iter().any(|value| value.as_str() == Some(id)))
+}
+
+fn set_not_destroyed<'a>(
+    data: &'a Value,
+    id: &str,
+) -> Option<&'a serde_json::Map<String, Value>> {
+    data["notDestroyed"][id].as_object()
+}
+
+// ---------------------------------------------------------------------------
+// Account provisioning
+// ---------------------------------------------------------------------------
+
+/// Result of `PUT /__ato/accounts/{account}`.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct ProvisionOutcome {
+    pub account: String,
+    pub created: bool,
+}
+
+impl IntoResponse for ProvisionOutcome {
+    fn into_response(self) -> Response {
+        let status = if self.created {
+            StatusCode::CREATED
+        } else {
+            StatusCode::OK
+        };
+        (status, Json(self)).into_response()
+    }
+}
+
+/// Look the account's domain up in Stalwart, then create the principal.
+///
+/// `endpoint` must be authenticated as the impersonator principal itself.
+/// An account that already exists is reported as `created: false`, not as an
+/// error. The generated password is only ever sent in the create request.
+pub async fn provision_account_in(
+    endpoint: &JmapEndpoint,
+    account: &Account,
+    display_name: Option<&str>,
+) -> std::result::Result<ProvisionOutcome, AccountsError> {
+    let domain_id = domain_id(endpoint, account.domain()).await?;
+    let password = random_password()?;
+    let create = json!({
+        "@type": "User",
+        "name": account.local_part(),
+        "domainId": domain_id,
+        "description": display_name.unwrap_or_default(),
+        "credentials": {"0": {"@type": "Password", "secret": password}},
+        "roles": {"@type": "User"},
+        "permissions": {"@type": "Inherit"},
+    });
+    let data = call(
+        endpoint,
+        "x:Account/set",
+        json!({"create": {"n": create}}),
+        "c0",
+    )
+    .await?;
+
+    if data["created"]["n"].is_object() {
+        return Ok(ProvisionOutcome {
+            account: account.address().to_string(),
+            created: true,
+        });
+    }
+    if let Some(error) = set_not_created(&data, "n") {
+        if is_already_exists(error) {
+            return Ok(ProvisionOutcome {
+                account: account.address().to_string(),
+                created: false,
+            });
+        }
+        let detail = error.get("type").and_then(Value::as_str).unwrap_or("unknown");
+        return Err(AccountsError::Provider {
+            detail: detail.to_string(),
+        });
+    }
+    Err(provider_invalid_response())
+}
+
+async fn domain_id(
+    endpoint: &JmapEndpoint,
+    domain: &str,
+) -> std::result::Result<String, AccountsError> {
+    let data = call(endpoint, "x:Domain/get", json!({}), "d0").await?;
+    let list = data["list"].as_array().ok_or_else(provider_invalid_response)?;
+    list.iter()
+        .find(|entry| {
+            entry["name"]
+                .as_str()
+                .is_some_and(|name| name.eq_ignore_ascii_case(domain))
+        })
+        .and_then(|entry| entry["id"].as_str())
+        .map(str::to_owned)
+        .ok_or_else(|| AccountsError::Provider {
+            // Not a JMAP error type: the domain exists in the config but not in
+            // Stalwart. The operator has to create the domain.
+            detail: "domain_not_found".to_string(),
+        })
+}
+
+/// A generated mailbox password: 32 bytes from the OS CSPRNG, hex encoded.
+///
+/// Never logged and never returned. `/dev/urandom` is the CSPRNG of every
+/// platform the image runs on (Linux in the container, the host for tests).
+#[cfg(unix)]
+fn random_password() -> std::result::Result<String, AccountsError> {
+    use std::io::Read;
+
+    let mut bytes = [0u8; RANDOM_PASSWORD_BYTES];
+    let mut source = std::fs::File::open("/dev/urandom").map_err(|_| AccountsError::Internal)?;
+    source
+        .read_exact(&mut bytes)
+        .map_err(|_| AccountsError::Internal)?;
+    Ok(hex::encode(bytes))
+}
+
+#[cfg(not(unix))]
+fn random_password() -> std::result::Result<String, AccountsError> {
+    Err(AccountsError::Internal)
+}
+
+// ---------------------------------------------------------------------------
+// App passwords
+// ---------------------------------------------------------------------------
+
+/// One app password as reported by `GET`. Never carries the secret.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct AppPasswordSummary {
+    pub id: String,
+    pub description: String,
+    pub created_at: Option<String>,
+    pub expires_at: Option<String>,
+}
+
+/// Body of `GET /__ato/accounts/{account}/app-passwords`.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct AppPasswordList {
+    pub app_passwords: Vec<AppPasswordSummary>,
+}
+
+impl IntoResponse for AppPasswordList {
+    fn into_response(self) -> Response {
+        (StatusCode::OK, Json(self)).into_response()
+    }
+}
+
+/// Body of a successful `POST /__ato/accounts/{account}/app-passwords`.
+///
+/// This is the only response that carries `secret`: Stalwart generates it and
+/// only returns it from the create call.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub struct CreatedAppPassword {
+    pub id: String,
+    pub description: String,
+    pub created_at: Option<String>,
+    pub expires_at: Option<String>,
+    pub secret: String,
+}
+
+impl IntoResponse for CreatedAppPassword {
+    fn into_response(self) -> Response {
+        (StatusCode::CREATED, Json(self)).into_response()
+    }
+}
+
+fn app_password_summary(item: &Value) -> AppPasswordSummary {
+    AppPasswordSummary {
+        id: item["id"].as_str().unwrap_or_default().to_string(),
+        description: item["description"].as_str().unwrap_or_default().to_string(),
+        created_at: item["createdAt"].as_str().map(str::to_owned),
+        expires_at: item["expiresAt"].as_str().map(str::to_owned),
+    }
+}
+
+fn now_rfc3339() -> String {
+    chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Secs, true)
+}
+
+/// List the account's app passwords.
+///
+/// `endpoint` must be authenticated as `{account}` through the impersonator.
+pub async fn list_app_passwords_in(
+    endpoint: &JmapEndpoint,
+) -> std::result::Result<AppPasswordList, AccountsError> {
+    let data = call(endpoint, "x:AppPassword/get", json!({}), "l0").await?;
+    let list = data["list"].as_array().ok_or_else(provider_invalid_response)?;
+    Ok(AppPasswordList {
+        app_passwords: list.iter().map(app_password_summary).collect(),
+    })
+}
+
+/// Create an app password and return Stalwart's generated secret.
+pub async fn create_app_password_in(
+    endpoint: &JmapEndpoint,
+    description: &str,
+    expires_at: Option<&str>,
+) -> std::result::Result<CreatedAppPassword, AccountsError> {
+    validate_description(description)?;
+    if let Some(expires_at) = expires_at {
+        validate_expires_at(expires_at)?;
+    }
+
+    let mut object = json!({"description": description});
+    if let Some(expires_at) = expires_at {
+        object["expiresAt"] = json!(expires_at);
+    }
+    let data = call(
+        endpoint,
+        "x:AppPassword/set",
+        json!({"create": {"k": object}}),
+        "c0",
+    )
+    .await?;
+
+    let Some(created) = data["created"]["k"].as_object() else {
+        if let Some(error) = set_not_created(&data, "k") {
+            let detail = error.get("type").and_then(Value::as_str).unwrap_or("unknown");
+            return Err(AccountsError::Provider {
+                detail: detail.to_string(),
+            });
+        }
+        return Err(provider_invalid_response());
+    };
+
+    let Some(secret) = created.get("secret").and_then(Value::as_str) else {
+        // Stalwart always returns the secret from a create. Without it the
+        // password exists but nobody can use it: report a provider failure
+        // instead of pretending the caller has one.
+        return Err(provider_invalid_response());
+    };
+    let id = created
+        .get("id")
+        .and_then(Value::as_str)
+        .ok_or_else(provider_invalid_response)?;
+
+    Ok(CreatedAppPassword {
+        id: id.to_string(),
+        description: description.to_string(),
+        created_at: Some(
+            created
+                .get("createdAt")
+                .and_then(Value::as_str)
+                .map(str::to_owned)
+                .unwrap_or_else(now_rfc3339),
+        ),
+        expires_at: created
+            .get("expiresAt")
+            .and_then(Value::as_str)
+            .map(str::to_owned)
+            .or_else(|| expires_at.map(str::to_owned)),
+        secret: secret.to_string(),
+    })
+}
+
+/// Revoke one app password. An unknown or already-revoked id is a success, so
+/// Ato can retry the deletion.
+pub async fn destroy_app_password_in(
+    endpoint: &JmapEndpoint,
+    id: &str,
+) -> std::result::Result<(), AccountsError> {
+    let data = call(
+        endpoint,
+        "x:AppPassword/set",
+        json!({"destroy": [id]}),
+        "d0",
+    )
+    .await?;
+    if set_destroyed(&data, id) {
+        return Ok(());
+    }
+    if let Some(error) = set_not_destroyed(&data, id) {
+        if is_not_found(error) {
+            return Ok(());
+        }
+        let detail = error.get("type").and_then(Value::as_str).unwrap_or("unknown");
+        return Err(AccountsError::Provider {
+            detail: detail.to_string(),
+        });
+    }
+    Err(provider_invalid_response())
+}
+
+/// Revoke every app password the account has, then report success.
+pub async fn destroy_all_app_passwords_in(
+    endpoint: &JmapEndpoint,
+) -> std::result::Result<(), AccountsError> {
+    let list = list_app_passwords_in(endpoint).await?;
+    let ids: Vec<&str> = list
+        .app_passwords
+        .iter()
+        .map(|password| password.id.as_str())
+        .filter(|id| !id.is_empty())
+        .collect();
+    if ids.is_empty() {
+        return Ok(());
+    }
+
+    let data = call(
+        endpoint,
+        "x:AppPassword/set",
+        json!({"destroy": ids}),
+        "d0",
+    )
+    .await?;
+    if let Some(errors) = data["notDestroyed"].as_object() {
+        for error in errors.values() {
+            if let Some(error) = error.as_object()
+                && !is_not_found(error)
+            {
+                let detail = error.get("type").and_then(Value::as_str).unwrap_or("unknown");
+                return Err(AccountsError::Provider {
+                    detail: detail.to_string(),
+                });
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Validate an app-password description: 1 to 80 characters.
+pub fn validate_description(description: &str) -> std::result::Result<(), AccountsError> {
+    let length = description.chars().count();
+    if length == 0 || length > MAX_DESCRIPTION_CHARS {
+        Err(AccountsError::InvalidDescription)
+    } else {
+        Ok(())
+    }
+}
+
+/// Validate an app-password expiry as RFC 3339.
+pub fn validate_expires_at(expires_at: &str) -> std::result::Result<(), AccountsError> {
+    chrono::DateTime::parse_from_rfc3339(expires_at)
+        .map(|_| ())
+        .map_err(|_| AccountsError::InvalidExpiresAt)
+}
+
+// ---------------------------------------------------------------------------
+// Connections
+// ---------------------------------------------------------------------------
+
+async fn connect_provisioner(
+    identity: &AtoIdentity,
+    jmap_url: &JmapUrl,
+) -> std::result::Result<JmapEndpoint, AccountsError> {
+    let client = jmap::create_client(jmap_url, identity.impersonator(), identity.password())
+        .await
+        .map_err(|error| provider_from_error(&error))?;
+    Ok(JmapEndpoint::from_client(&client))
+}
+
+async fn connect_account(
+    identity: &AtoIdentity,
+    jmap_url: &JmapUrl,
+    account: &str,
+) -> std::result::Result<JmapEndpoint, AccountsError> {
+    let username = identity.impersonation_username(account);
+    let client = jmap::create_client(jmap_url, &username, identity.password())
+        .await
+        .map_err(|error| provider_from_error(&error))?;
+    Ok(JmapEndpoint::from_client(&client))
+}
+
+fn enabled_identity(
+    state: &AtoIdentityState,
+) -> std::result::Result<Arc<AtoIdentity>, AccountsError> {
+    state.0.clone().ok_or(AccountsError::NotFound)
+}
+
+fn provisionable_account(
+    identity: &AtoIdentity,
+    value: &str,
+) -> std::result::Result<Account, AccountsError> {
+    let account = parse_account(value)?;
+    ensure_domain_provisioned(identity.provision_domains(), &account)?;
+    Ok(account)
+}
+
+fn impersonated_account(
+    identity: &AtoIdentity,
+    headers: &HeaderMap,
+    value: &str,
+) -> std::result::Result<Account, AccountsError> {
+    let account = parse_account(value)?;
+    ensure_account_header(identity, headers, &account)?;
+    Ok(account)
+}

+    async fn list_app_passwords_never_returns_the_secret() {
+        let mock = MockJmap::start(vec![method_ok(
+            "x:AppPassword/get",
+            json!({"list": [{
+                "id": "p1",
+                "description": "Laptop IMAP",
+                "createdAt": "2026-11-21T05:00:00Z",
+                "expiresAt": null,
+                "allowedIps": [],
+                "permissions": {},
+                "secret": "must-not-leak",
+            }]}),
+            "l0",
+        )])
+        .await;
+
+        let list = list_app_passwords_in(&mock.endpoint).await.unwrap();
+        assert_eq!(
+            list.app_passwords,
+            vec![AppPasswordSummary {
+                id: "p1".to_string(),
+                description: "Laptop IMAP".to_string(),
+                created_at: Some("2026-11-21T05:00:00Z".to_string()),
+                expires_at: None,
+            }]
+        );
+        let (status, body) = response_json(list.into_response()).await;
+        assert_eq!(status, StatusCode::OK);
+        assert_eq!(
+            body,
+            json!({"app_passwords": [{
+                "id": "p1",
+                "description": "Laptop IMAP",
+                "created_at": "2026-11-21T05:00:00Z",
+                "expires_at": null,
+            }]})
+        );
+        assert!(!body.to_string().contains("secret"));
+        assert!(!body.to_string().contains("must-not-leak"));
+
+        assert_eq!(
+            mock.requests(),
+            vec![json!({
+                "using": ["urn:ietf:params:jmap:core", "urn:stalwart:jmap"],
+                "methodCalls": [["x:AppPassword/get", {"accountId": "u1"}, "l0"]],
+            })]
+        );
+    }
+
+    #[tokio::test]
+    async fn create_app_password_returns_the_secret_only_here() {
+        let mock = MockJmap::start(vec![method_ok(
+            "x:AppPassword/set",
+            json!({"created": {"k": {"id": "p2", "secret": "generated-secret"}}}),
+            "c0",
+        )])
+        .await;
+
+        let created =
+            create_app_password_in(&mock.endpoint, "Phone", Some("2030-01-01T00:00:00Z"))
+                .await
+                .unwrap();
+        assert_eq!(created.id, "p2");
+        assert_eq!(created.description, "Phone");
+        assert_eq!(created.secret, "generated-secret");
+        assert_eq!(created.expires_at.as_deref(), Some("2030-01-01T00:00:00Z"));
+        // Stalwart does not return createdAt from a create; the response still
+        // carries a timestamp.
+        let created_at = created.created_at.clone().unwrap();
+        assert!(chrono::DateTime::parse_from_rfc3339(&created_at).is_ok());
+
+        let (status, body) = response_json(created.into_response()).await;
+        assert_eq!(status, StatusCode::CREATED);
+        assert_eq!(body["id"], json!("p2"));
+        assert_eq!(body["description"], json!("Phone"));
+        assert_eq!(body["expires_at"], json!("2030-01-01T00:00:00Z"));
+        assert_eq!(body["secret"], json!("generated-secret"));
+
+        assert_eq!(
+            mock.requests(),
+            vec![json!({
+                "using": ["urn:ietf:params:jmap:core", "urn:stalwart:jmap"],
+                "methodCalls": [["x:AppPassword/set", {
+                    "accountId": "u1",
+                    "create": {"k": {
+                        "description": "Phone",
+                        "expiresAt": "2030-01-01T00:00:00Z",
+                    }},
+                }, "c0"]],
+            })]
+        );
+    }
+
+    #[tokio::test]
+    async fn create_app_password_omits_an_absent_expiry() {
+        let mock = MockJmap::start(vec![method_ok(
+            "x:AppPassword/set",
+            json!({"created": {"k": {"id": "p2", "secret": "generated-secret"}}}),
+            "c0",
+        )])
+        .await;
+        create_app_password_in(&mock.endpoint, "Phone", None)
+            .await
+            .unwrap();
+        let requests = mock.requests();
+        assert_eq!(
+            requests[0]["methodCalls"][0][1]["create"]["k"],
+            json!({"description": "Phone"})
+        );
+    }
+
+    #[test]
+    fn create_app_password_validates_the_description_and_expiry() {
+        assert_eq!(
+            validate_description(""),
+            Err(AccountsError::InvalidDescription)
+        );
+        assert_eq!(
+            validate_description(&"x".repeat(MAX_DESCRIPTION_CHARS + 1)),
+            Err(AccountsError::InvalidDescription)
+        );
+        assert!(validate_description(&"x".repeat(MAX_DESCRIPTION_CHARS)).is_ok());
+        assert!(validate_description("ラップトップ").is_ok());
+
+        assert!(validate_expires_at("2030-01-01T00:00:00Z").is_ok());
+        assert!(validate_expires_at("2030-01-01T09:00:00+09:00").is_ok());
+        assert_eq!(
+            validate_expires_at("tomorrow"),
+            Err(AccountsError::InvalidExpiresAt)
+        );
+        assert_eq!(
+            validate_expires_at("2030-01-01"),
+            Err(AccountsError::InvalidExpiresAt)
+        );
+    }
+
+    #[tokio::test]
+    async fn invalid_description_and_expiry_answer_400() {
+        let (status, body) = response_json(AccountsError::InvalidDescription.into_response()).await;
+        assert_eq!(status, StatusCode::BAD_REQUEST);
+        assert_eq!(body, json!({"error": "invalid_description"}));
+        let (status, body) = response_json(AccountsError::InvalidExpiresAt.into_response()).await;
+        assert_eq!(status, StatusCode::BAD_REQUEST);
+        assert_eq!(body, json!({"error": "invalid_expires_at"}));
+    }
+
+    #[tokio::test]
+    async fn destroy_app_password_sends_the_destroy_request() {
+        let mock = MockJmap::start(vec![method_ok(
+            "x:AppPassword/set",
+            json!({"destroyed": ["p1"]}),
+            "d0",
+        )])
+        .await;
+        destroy_app_password_in(&mock.endpoint, "p1")
+            .await
+            .unwrap();
+        assert_eq!(
+            mock.requests(),
+            vec![json!({
+                "using": ["urn:ietf:params:jmap:core", "urn:stalwart:jmap"],
+                "methodCalls": [["x:AppPassword/set", {
+                    "accountId": "u1",
+                    "destroy": ["p1"],
+                }, "d0"]],
+            })]
+        );
+    }
+
+    #[tokio::test]
+    async fn destroy_app_password_treats_an_unknown_id_as_success() {
+        let mock = MockJmap::start(vec![method_ok(
+            "x:AppPassword/set",
+            json!({"notDestroyed": {"p1": {"type": "notFound", "description": "no such password"}}}),
+            "d0",
+        )])
+        .await;
+        destroy_app_password_in(&mock.endpoint, "p1")
+            .await
+            .unwrap();
+    }
+
+    #[tokio::test]
+    async fn destroy_all_app_passwords_lists_then_destroys_every_id() {
+        let mock = MockJmap::start(vec![
+            method_ok(
+                "x:AppPassword/get",
+                json!({"list": [{"id": "p1"}, {"id": "p2"}]}),
+                "l0",
+            ),
+            method_ok(
+                "x:AppPassword/set",
+                json!({"destroyed": ["p1", "p2"]}),
+                "d0",
+            ),
+        ])
+        .await;
+        destroy_all_app_passwords_in(&mock.endpoint).await.unwrap();
+        let requests = mock.requests();
+        assert_eq!(requests.len(), 2);
+        assert_eq!(
+            requests[1],
+            json!({
+                "using": ["urn:ietf:params:jmap:core", "urn:stalwart:jmap"],
+                "methodCalls": [["x:AppPassword/set", {
+                    "accountId": "u1",
+                    "destroy": ["p1", "p2"],
+                }, "d0"]],
+            })
+        );
+    }
+
+    #[tokio::test]
+    async fn destroy_all_app_passwords_with_none_does_not_send_a_destroy() {
+        let mock = MockJmap::start(vec![method_ok(
+            "x:AppPassword/get",
+            json!({"list": []}),
+            "l0",
+        )])
+        .await;
+        destroy_all_app_passwords_in(&mock.endpoint).await.unwrap();
+        assert_eq!(mock.requests().len(), 1);
+    }
+
+    #[test]
+    fn generated_passwords_come_from_the_os_csprng() {
+        let first = random_password().unwrap();
+        let second = random_password().unwrap();
+        assert_eq!(first.len(), RANDOM_PASSWORD_BYTES * 2);
+        assert_ne!(first, second);
+    }
+}

+            MissiveError::AtoIdentityHeaderInvalid => plain_page(
+                StatusCode::BAD_REQUEST,
+                "This request did not carry a valid Ato account.",
+            ),
+            MissiveError::AtoIdentityServerUnavailable => plain_page(
+                StatusCode::BAD_GATEWAY,
+                "The mail server could not be reached for this account.",
+            ),
+            MissiveError::SessionRequired => Redirect::to("/login").into_response(),
+            MissiveError::Jmap(kind) => html_error(StatusCode::BAD_GATEWAY, &kind.to_string()),
+            MissiveError::AuthFailed => html_error(StatusCode::UNAUTHORIZED, "Invalid credentials"),
+            MissiveError::HttpResponse(msg) => html_error(StatusCode::INTERNAL_SERVER_ERROR, msg),
+        }

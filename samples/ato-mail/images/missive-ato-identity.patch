 }
 
+fn html_error(status: StatusCode, message: &str) -> Response {
+    (
+        status,
+        Html(format!("<div class=\"error\">{message}</div>")),
+    )
+        .into_response()
+}
+
+/// A minimal page for the Ato identity header failures: no app chrome and no
+/// login form.
+fn plain_page(status: StatusCode, message: &str) -> Response {
+    let title = status.canonical_reason().unwrap_or("Error");
+    (
+        status,
+        Html(format!(
+            "<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\"><title>{title}</title></head>\n<body>\n<p>{message}</p>\n</body>\n</html>\n"
+        )),
+    )
+        .into_response()
+}

+/// Optional `[ato_identity]` section.
+///
+/// When it is present (and its password environment variable is set), Missive
+/// accepts Ato's account header and opens the named mailbox through a Stalwart
+/// master-user (impersonator) instead of Missive's own login. When it is
+/// absent, Missive behaves exactly as before.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct AtoIdentityConfig {
+    /// Request header carrying the signed-in person's app account.
+    #[serde(default = "default_account_header")]
+    pub account_header: String,
+    /// Master-user principal holding only `authenticate` and `impersonate`.
+    pub impersonator: String,
+    /// Environment variable holding the impersonator's password.
+    pub impersonator_password_env: String,
+}
+
+impl AtoIdentityConfig {
+    /// Read `[ato_identity]` straight from a config file.
+    ///
+    /// `main.rs` needs this because figment does not deserialize flattened
+    /// custom fields reliably (the same reason `jmap_url` has a fallback).
+    pub fn from_toml(raw: &str) -> Option<Self> {
+        let table = raw.parse::<toml::Table>().ok()?;
+        table.get("ato_identity")?.clone().try_into().ok()
+    }
+}
+
 #[derive(Debug, Clone, Serialize, Deserialize)]
 pub struct WebhookConfig {
     pub url: String,
@@ -96,4 +131,49 @@ mod tests {
         assert_eq!(url.as_str(), "https://mail.example.com");
         assert!(!url.is_empty());
     }
+
+    #[test]
+    fn ato_identity_section_is_optional() {
+        let raw = "jmap_url = \"http://stalwart:8080\"\n";
+        assert!(AtoIdentityConfig::from_toml(raw).is_none());
+    }
+
+    #[test]
+    fn ato_identity_section_is_read_from_the_config_file() {
+        let raw = r#"
+jmap_url = "http://stalwart:8080"
+
+[ato_identity]
+account_header = "x-ato-account"
+impersonator = "ato-webmail-broker@example.test"
+impersonator_password_env = "MISSIVE_ATO_IMPERSONATOR_PASSWORD"
+"#;
+        let config = AtoIdentityConfig::from_toml(raw).unwrap();
+        assert_eq!(config.account_header, "x-ato-account");
+        assert_eq!(
+            config.impersonator,
+            "ato-webmail-broker@example.test"
+        );
+        assert_eq!(
+            config.impersonator_password_env,
+            "MISSIVE_ATO_IMPERSONATOR_PASSWORD"
+        );
+    }
+
+    #[test]
+    fn ato_identity_account_header_defaults_to_x_ato_account() {
+        let raw = r#"
+[ato_identity]
+impersonator = "ato-webmail-broker@example.test"
+impersonator_password_env = "MISSIVE_ATO_IMPERSONATOR_PASSWORD"
+"#;
+        let config = AtoIdentityConfig::from_toml(raw).unwrap();
+        assert_eq!(config.account_header, "x-ato-account");
+    }
+
+    #[test]
+    fn config_without_ato_identity_keeps_the_default() {
+        let config = MissiveConfig::default();
+        assert!(config.ato_identity.is_none());
+    }
 }

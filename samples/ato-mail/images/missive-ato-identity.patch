index 0000000..21fff9d
--- /dev/null
+++ b/src/ato_identity.rs
@@ -0,0 +1,373 @@
+//! Ato identity header support.
+//!
+//! Ato's app gateway removes client-sent identity headers and adds
+//! `X-Ato-Account: <the signed-in person's app account>` to every request it
+//! forwards to an app that opted into identity forwarding (only Ato's gateway
+//! can reach the app). Missive accepts that header so a person who is signed in
+//! to Ato opens their mailbox without Missive's login form.
+//!
+//! The person's mail password is never available on that path. Instead Missive
+//! signs in to the mail server as the target account through a Stalwart
+//! master-user (impersonator) principal that holds only the `authenticate` and
+//! `impersonate` permissions: the JMAP user name is
+//! `<account>%<impersonator>` and the password is the impersonator's own. The
+//! broker password lives only in a process environment variable; it is never
+//! written to the session or to a log.
+//!
+//! This module is opt-in. Without `[ato_identity]` in the config, or when the
+//! impersonator password environment variable is unset or empty, the header is
+//! ignored and Missive behaves exactly as before.
+
+use std::sync::Arc;
+
+use acton_service::prelude::*;
+use axum::http::HeaderName;
+use jmap_client::client::Client;
+use secrecy::{ExposeSecret, SecretString};
+
+use crate::config::AtoIdentityConfig;
+use crate::error::MissiveError;
+use crate::jmap::{self, JmapClientCache, JmapUrl};
+use crate::session::MissiveSession;
+
+/// Longest account value the header may carry.
+const MAX_ACCOUNT_LEN: usize = 255;
+
+/// The resolved `[ato_identity]` section.
+#[derive(Debug, Clone)]
+pub struct AtoIdentity {
+    header: HeaderName,
+    impersonator: String,
+    password: SecretString,
+}
+
+/// Request extension carrying the resolved identity, or none when the feature
+/// is not enabled.
+#[derive(Debug, Clone, Default)]
+pub struct AtoIdentityState(pub Option<Arc<AtoIdentity>>);
+
+/// What the Ato account header means for the current session.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum AccountDecision {
+    /// No header: keep the existing password-session path.
+    Unchanged,
+    /// Same account with a cached client: reuse it.
+    Reuse,
+    /// Connect through the impersonator and replace the session.
+    Connect,
+}
+
+impl AtoIdentity {
+    /// Resolve the configured section against its password environment variable.
+    ///
+    /// Returns `None` when the section is absent or the environment variable is
+    /// unset or empty. In the latter case one warning is logged at startup and
+    /// the service behaves as if the section were absent; no other password is
+    /// ever tried.
+    pub fn from_config(config: Option<&AtoIdentityConfig>) -> Option<Self> {
+        let config = config?;
+        let password = match std::env::var(&config.impersonator_password_env) {
+            Ok(password) if !password.is_empty() => SecretString::from(password),
+            _ => {
+                warn!(
+                    "[ato_identity] the section is configured but {} is unset or empty; the Ato identity header is ignored",
+                    config.impersonator_password_env
+                );
+                return None;
+            }
+        };
+        let header = match HeaderName::from_bytes(config.account_header.as_bytes()) {
+            Ok(header) => header,
+            Err(_) => {
+                warn!(
+                    "[ato_identity] account_header {:?} is not a valid HTTP header name; the Ato identity header is ignored",
+                    config.account_header
+                );
+                return None;
+            }
+        };
+        info!(
+            "[ato_identity] enabled for header {} with impersonator {}",
+            header, config.impersonator
+        );
+        Some(Self {
+            header,
+            impersonator: config.impersonator.clone(),
+            password,
+        })
+    }
+
+    /// The HTTP header carrying the account.
+    pub fn header(&self) -> &HeaderName {
+        &self.header
+    }
+
+    /// The JMAP Basic-auth user name for a Stalwart master-user sign-in.
+    pub fn impersonation_username(&self, account: &str) -> String {
+        format!("{account}%{}", self.impersonator)
+    }
+
+    /// The impersonator's password. Never store or log it.
+    fn password(&self) -> &str {
+        self.password.expose_secret()
+    }
+}
+
+impl AtoIdentityState {
+    /// The account named by `headers`, or `None` when the header is absent or
+    /// identity forwarding is disabled.
+    pub fn account<'a>(
+        &'a self,
+        headers: &HeaderMap,
+    ) -> std::result::Result<Option<(&'a AtoIdentity, String)>, MissiveError> {
+        let Some(identity) = self.0.as_deref() else {
+            return Ok(None);
+        };
+        let Some(value) = headers.get(identity.header()) else {
+            return Ok(None);
+        };
+        let value = value
+            .to_str()
+            .map_err(|_| MissiveError::AtoIdentityHeaderInvalid)?;
+        validate_account(value)?;
+        Ok(Some((identity, value.to_owned())))
+    }
+}
+
+/// Validate the account value carried by the header.
+///
+/// The value must be 1–255 printable ASCII characters (0x21–0x7E), contain
+/// exactly one `@`, and must not contain `%` (which Stalwart uses to encode
+/// master-user impersonation).
+pub fn validate_account(account: &str) -> std::result::Result<(), MissiveError> {
+    let bytes = account.as_bytes();
+    let valid = !bytes.is_empty()
+        && bytes.len() <= MAX_ACCOUNT_LEN
+        && bytes.iter().all(|byte| (0x21..=0x7e).contains(byte))
+        && bytes.iter().filter(|byte| **byte == b'@').count() == 1
+        && !bytes.contains(&b'%');
+    if valid {
+        Ok(())
+    } else {
+        Err(MissiveError::AtoIdentityHeaderInvalid)
+    }
+}
+
+/// Decide what a header value means for a session.
+///
+/// `cached` says whether the client cache already holds a client for the
+/// header's account.
+pub fn decide_account(
+    account: Option<&str>,
+    session_username: Option<&str>,
+    cached: bool,
+) -> AccountDecision {
+    match account {
+        None => AccountDecision::Unchanged,
+        Some(account) if session_username == Some(account) && cached => AccountDecision::Reuse,
+        Some(_) => AccountDecision::Connect,
+    }
+}
+
+/// Make `session` the impersonated session for `account` and return its JMAP
+/// client, connecting through the impersonator when the cache is cold.
+///
+/// The session keeps only the account name: no password (the broker's or the
+/// person's) is stored for a session opened this way.
+/// End a session the gateway no longer vouches for: remove its cached client
+/// and clear the session, so the next page is the password form.
+pub async fn forget_account(
+    cache: &JmapClientCache,
+    account: &str,
+    session: &mut TypedSession<MissiveSession>,
+) {
+    cache.remove(account);
+    let _ = session.clear().await;
+}
+
+pub async fn open_account(
+    identity: &AtoIdentity,
+    cache: &JmapClientCache,
+    jmap_url: &JmapUrl,
+    account: &str,
+    session: &mut TypedSession<MissiveSession>,
+) -> std::result::Result<Arc<Client>, MissiveError> {
+    let previous = session.data().username.clone();
+    let cached = cache.get(account).map(|client| Arc::clone(client.value()));
+    let decision = decide_account(Some(account), previous.as_deref(), cached.is_some());
+    if decision == AccountDecision::Reuse
+        && let Some(client) = cached
+    {
+        return Ok(client);
+    }
+
+    if let Some(previous) = previous.as_deref()
+        && previous != account
+    {
+        cache.remove(previous);
+        let _ = session.clear().await;
+    }
+
+    let username = identity.impersonation_username(account);
+    let client = jmap::create_client(jmap_url, &username, identity.password())
+        .await
+        .map_err(|error| {
+            warn!("[ato_identity] could not open a JMAP session for {account}: {error}");
+            MissiveError::AtoIdentityServerUnavailable
+        })?;
+    let client = Arc::new(client);
+    cache.insert(account.to_owned(), Arc::clone(&client));
+
+    let data = session.data_mut();
+    data.username = Some(account.to_owned());
+    data.password = None;
+    let _ = session.save().await;
+
+    Ok(client)
+}
+
+/// Resolve the account for a server-rendered page.
+///
+/// Returns `Ok(None)` when the request carries no Ato identity header; the
+/// page then keeps using the password session exactly as before.
+pub async fn page_account(
+    identity: &AtoIdentityState,
+    cache: &JmapClientCache,
+    jmap_url: &JmapUrl,
+    headers: &HeaderMap,
+    session: &mut TypedSession<MissiveSession>,
+) -> std::result::Result<Option<String>, MissiveError> {
+    let Some((identity, account)) = identity.account(headers)? else {
+        return Ok(None);
+    };
+    open_account(identity, cache, jmap_url, &account, session).await?;
+    Ok(Some(account))
+}
+
+#[cfg(test)]
+mod tests {
+    #![allow(clippy::unwrap_used)]
+
+    use super::*;
+
+    fn identity(account_header: &str) -> AtoIdentity {
+        AtoIdentity {
+            header: HeaderName::from_bytes(account_header.as_bytes()).unwrap(),
+            impersonator: "ato-webmail-broker@example.test".to_string(),
+            password: SecretString::from("broker-password"),
+        }
+    }
+
+    fn state(account_header: &str) -> AtoIdentityState {
+        AtoIdentityState(Some(Arc::new(identity(account_header))))
+    }
+
+    #[test]
+    fn account_header_accepts_a_normal_address() {
+        assert!(validate_account("alice@example.test").is_ok());
+    }
+
+    #[test]
+    fn account_header_requires_exactly_one_at() {
+        assert!(validate_account("alice.example.test").is_err());
+        assert!(validate_account("alice@@example.test").is_err());
+    }
+
+    #[test]
+    fn account_header_rejects_a_percent() {
+        assert!(validate_account("alice%example.test").is_err());
+        assert!(validate_account("alice@example.test%broker@example.test").is_err());
+    }
+
+    #[test]
+    fn account_header_rejects_non_ascii() {
+        assert!(validate_account("alice@exämple.test").is_err());
+        assert!(validate_account("alïce@example.test").is_err());
+    }
+
+    #[test]
+    fn account_header_rejects_empty_space_and_too_long_values() {
+        assert!(validate_account("").is_err());
+        assert!(validate_account("alice @example.test").is_err());
+        let long = format!(
+            "{}@example.test",
+            "a".repeat(MAX_ACCOUNT_LEN - "@example.test".len())
+        );
+        assert_eq!(long.len(), MAX_ACCOUNT_LEN);
+        assert!(validate_account(&long).is_ok());
+        let too_long = format!("{long}a");
+        assert!(validate_account(&too_long).is_err());
+    }
+
+    #[test]
+    fn absent_header_keeps_the_password_path() {
+        let identity = state("x-ato-account");
+        let headers = HeaderMap::new();
+        assert!(matches!(identity.account(&headers), Ok(None)));
+        assert_eq!(
+            decide_account(None, Some("alice@example.test"), true),
+            AccountDecision::Unchanged
+        );
+    }
+
+    #[test]
+    fn same_account_with_a_cached_client_is_reused() {
+        assert_eq!(
+            decide_account(Some("alice@example.test"), Some("alice@example.test"), true),
+            AccountDecision::Reuse
+        );
+    }
+
+    #[test]
+    fn different_account_replaces_the_session() {
+        assert_eq!(
+            decide_account(Some("bob@example.test"), Some("alice@example.test"), true),
+            AccountDecision::Connect
+        );
+        assert_eq!(
+            decide_account(Some("alice@example.test"), None, false),
+            AccountDecision::Connect
+        );
+        // Same account but a cold cache must connect again: an impersonated
+        // session has no password to rebuild the client from.
+        assert_eq!(
+            decide_account(
+                Some("alice@example.test"),
+                Some("alice@example.test"),
+                false
+            ),
+            AccountDecision::Connect
+        );
+    }
+
+    #[test]
+    fn impersonation_username_is_account_percent_impersonator() {
+        assert_eq!(
+            identity("x-ato-account").impersonation_username("alice@example.test"),
+            "alice@example.test%ato-webmail-broker@example.test"
+        );
+    }
+
+    #[test]
+    fn header_lookup_is_case_insensitive_and_ignores_disabled_state() {
+        let identity = state("x-ato-account");
+        let mut headers = HeaderMap::new();
+        headers.insert("X-Ato-Account", "alice@example.test".parse().unwrap());
+        assert_eq!(
+            identity.account(&headers).unwrap().unwrap().1,
+            "alice@example.test"
+        );
+        assert!(AtoIdentityState(None).account(&headers).unwrap().is_none());
+    }
+
+    #[test]
+    fn invalid_header_value_is_rejected() {
+        let identity = state("x-ato-account");
+        let mut headers = HeaderMap::new();
+        headers.insert("x-ato-account", "not-an-address".parse().unwrap());
+        assert!(matches!(
+            identity.account(&headers),
+            Err(MissiveError::AtoIdentityHeaderInvalid)
+        ));
+    }
+}

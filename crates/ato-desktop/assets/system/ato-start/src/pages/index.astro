---
import "../styles/tailwind.css";
import BackgroundDecorations from "../components/BackgroundDecorations.astro";
import SearchSection from "../components/SearchSection.astro";
import ActionCards from "../components/ActionCards.astro";
import EmptyStateSection from "../components/EmptyStateSection.astro";
import FeaturedApps from "../components/FeaturedApps.astro";
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>新しいウィンドウ</title>
</head>
<body class="bg-white font-sans selection:bg-slate-200 selection:text-slate-900 overflow-hidden w-screen h-screen">
  <div class="relative w-full h-full">

    <BackgroundDecorations />

    <div class="absolute inset-0 z-10 flex flex-col">
      <div class="flex-1 overflow-y-auto px-8 pb-8 custom-scrollbar">
        <!-- Running apps row — derived from the SessionRegistry (source + OCI),
             not from visible windows. Populated by the snapshot script below. -->
        <div id="runningAppsRow" class="hidden"></div>
        <SearchSection />
        <ActionCards />
        <EmptyStateSection />
        <FeaturedApps />
      </div>
    </div>

    <button id="settingsBtn" class="absolute bottom-6 left-6 z-30 w-9 h-9 bg-white rounded-[10px] shadow-sm border border-slate-200 flex items-center justify-center text-slate-400 hover:text-slate-600 hover:bg-slate-50 hover:shadow transition-all">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
    </button>
  </div>

  <style is:global>
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background-color: #E2E8F0; border-radius: 20px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background-color: #CBD5E1; }
  </style>

  <script>
    (function () {
      'use strict';

      function ipc(command) {
        if (window.ipc) {
          window.ipc.postMessage(JSON.stringify({ capsule: 'start', command }));
        }
      }

      const snap = window.__ATO_START_SNAPSHOT__ || {};
      const searchInput = document.getElementById('searchInput');
      const recentCapsulesContent = document.getElementById('recentCapsulesContent');
      const localAppsContent = document.getElementById('localAppsContent');
      const runningAppsRow = document.getElementById('runningAppsRow');

      function runningDotColor(status) {
        if (status === 'failed') return '#ef4444';   // red
        if (status === 'background') return '#f59e0b'; // amber — running, no window
        return '#10b981';                              // green — running, visible
      }

      // Render the "開いているアプリ" row from running sessions. A session stays
      // listed while its process runs even after its window closes (background);
      // OCI multi-service apps appear once per session.
      function renderRunningApps(list) {
        if (!runningAppsRow) return;
        runningAppsRow.innerHTML = '';
        const apps = Array.isArray(list) ? list : [];
        if (!apps.length) {
          runningAppsRow.className = 'hidden';
          return;
        }
        runningAppsRow.className = 'flex flex-wrap gap-2 pt-4 pb-1';
        apps.forEach(function (app) {
          const pill = document.createElement('button');
          pill.type = 'button';
          pill.className = 'inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-slate-200 bg-white text-[12px] text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition-colors max-w-[220px]';
          const dot = document.createElement('span');
          dot.className = 'w-2 h-2 rounded-full shrink-0';
          dot.style.background = runningDotColor(app.status);
          const label = document.createElement('span');
          label.className = 'truncate';
          const name = app.display_name || app.handle || app.session_id || '';
          label.textContent = app.runtime_kind === 'oci' ? name + ' · OCI' : name;
          pill.appendChild(dot);
          pill.appendChild(label);
          pill.title = [String(app.runtime_kind || '').toUpperCase(), app.status, app.primary_url]
            .filter(Boolean)
            .join(' · ');
          // Re-open source apps by handle; OCI reopen is out of scope here.
          if (app.runtime_kind === 'source' && app.handle) {
            pill.addEventListener('click', function () {
              ipc({ kind: 'open_capsule', handle: app.handle });
            });
          } else {
            pill.style.cursor = 'default';
          }
          runningAppsRow.appendChild(pill);
        });
      }

      // Invoked from Rust (evaluate_script) after an async OCI session refresh.
      window.__ATO_RUNNING_APPS_REFRESH__ = function (list) {
        snap.running_apps = list;
        renderRunningApps(list);
      };

      function submitSearch() {
        const value = searchInput.value.trim();
        if (!value) return;
        ipc({ kind: 'open_query', value });
      }

      function fillSearch(value) {
        searchInput.value = value;
        searchInput.focus();
        searchInput.setSelectionRange(value.length, value.length);
      }

      function buildEntryButton(iconSvg, title, subtitle, onClick) {
        var button = document.createElement('button');
        button.type = 'button';
        button.className = 'w-full flex items-center gap-3 px-3 py-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 hover:border-slate-300 transition-colors text-left';
        button.addEventListener('click', onClick);

        var iconWrap = document.createElement('div');
        iconWrap.className = 'w-10 h-10 rounded-xl border border-slate-200 bg-slate-50 text-slate-400 shrink-0 flex items-center justify-center';
        iconWrap.innerHTML = iconSvg;

        var textWrap = document.createElement('div');
        textWrap.className = 'min-w-0 flex-1';

        var titleEl = document.createElement('div');
        titleEl.className = 'text-[12px] font-bold text-slate-700 truncate';
        titleEl.textContent = title;

        var subtitleEl = document.createElement('div');
        subtitleEl.className = 'text-[11px] text-slate-400 truncate mt-0.5';
        subtitleEl.textContent = subtitle;

        textWrap.appendChild(titleEl);
        textWrap.appendChild(subtitleEl);
        button.appendChild(iconWrap);
        button.appendChild(textWrap);
        return button;
      }

      function renderRecentCapsules() {
        if (!recentCapsulesContent) return;
        var entries = Array.isArray(snap.recent_capsules) ? snap.recent_capsules : [];
        if (!entries.length) return;

        recentCapsulesContent.innerHTML = '';
        recentCapsulesContent.className = 'min-h-28 border border-slate-200 bg-white rounded-2xl p-3 flex flex-col gap-2';

        entries.slice(0, 4).forEach(function (entry) {
          recentCapsulesContent.appendChild(
            buildEntryButton(
              '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 002 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>',
              entry.label || entry.handle || 'Capsule',
              entry.handle || '',
              function () {
                if (entry.handle) ipc({ kind: 'open_capsule', handle: entry.handle });
              }
            )
          );
        });
      }

      function renderLocalApps() {
        if (!localAppsContent) return;
        var entries = Array.isArray(snap.local_apps) ? snap.local_apps : [];
        if (!entries.length) return;

        localAppsContent.innerHTML = '';
        localAppsContent.className = 'min-h-28 border border-slate-200 bg-white rounded-2xl p-3 flex flex-col gap-2';

        entries.slice(0, 4).forEach(function (entry) {
          localAppsContent.appendChild(
            buildEntryButton(
              '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 002-2V8a2 2 0 00-2-2h-7.93a2 2 0 01-1.66-.9l-.82-1.2A2 2 0 007.93 3H4a2 2 0 00-2 2v13c0 1.1.9 2 2 2z"/></svg>',
              entry.name || 'Local app',
              entry.path || '',
              function () {
                if (entry.path) ipc({ kind: 'open_local_path', path: entry.path });
              }
            )
          );
        });
      }

      if (searchInput) {
        searchInput.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') submitSearch();
          if (e.key === 'Escape') ipc({ kind: 'close' });
        });
      }

      document.querySelectorAll('.chip[data-fill]').forEach(function (chip) {
        chip.addEventListener('click', function () {
          fillSearch(this.dataset.fill);
        });
      });

      document.querySelectorAll('.action-card[data-action]').forEach(function (card) {
        card.addEventListener('click', function () {
          var action = this.dataset.action;
          if (action === 'github') ipc({ kind: 'open_github_run' });
          else if (action === 'local') fillSearch('~/');
          else if (action === 'store') ipc({ kind: 'open_store' });
        });
      });

      document.querySelectorAll('.tab-btn[data-tab]').forEach(function (tab) {
        tab.addEventListener('click', function () {
          var t = this.dataset.tab;
          if (t === 'store') ipc({ kind: 'open_store' });
          else if (t === 'github') ipc({ kind: 'open_github_run' });
          else if (t === 'local') fillSearch('~/');
          else if (t === 'recent') ipc({ kind: 'show_all_recent' });
        });
      });

      document.querySelectorAll('.section-link[data-action]').forEach(function (link) {
        link.addEventListener('click', function () {
          var action = this.dataset.action;
          if (action === 'show_all_recent') ipc({ kind: 'show_all_recent' });
          else if (action === 'show_all_local') ipc({ kind: 'show_all_local' });
          else if (action === 'view_all_store') ipc({ kind: 'open_store' });
        });
      });

      document.querySelectorAll('.featured-card').forEach(function (card) {
        function openCommunityImport() {
          var source = card.dataset.source || card.dataset.query;
          if (!source) return;
          var command = { kind: 'open_community_import', source: source };
          if (card.dataset.label) command.label = card.dataset.label;
          ipc(command);
        }
        card.addEventListener('click', openCommunityImport);
        var launchBtn = card.querySelector('.featured-launch');
        if (launchBtn) {
          launchBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            openCommunityImport();
          });
        }
      });

      document.getElementById('settingsBtn').addEventListener('click', function () {
        ipc({ kind: 'open_settings' });
      });

      document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          if (searchInput) { searchInput.focus(); searchInput.select(); }
        }
      });

      renderRecentCapsules();
      renderLocalApps();
      renderRunningApps(snap.running_apps);

      if (searchInput) searchInput.focus();
    })();
  </script>
</body>
</html>

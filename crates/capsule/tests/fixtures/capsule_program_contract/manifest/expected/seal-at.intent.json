{
  "capsule_type": "app",
  "default_target": "app",
  "schema": "ato.capsule-program-manifest-intent/v1",
  "seal_at": {
    "command": [
      "sh",
      "-lc",
      "curl -fsS http://127.0.0.1:8080/ready",
      "--label",
      ""
    ],
    "timeout_seconds": 120
  },
  "snapshot": {
    "mode": "warm"
  },
  "targets": {
    "targets": {
      "app": {
        "image": "ghcr.io/example/app:1",
        "port": 8080,
        "runtime": "oci"
      }
    }
  }
}

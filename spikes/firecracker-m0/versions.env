# Pinned versions for the M0 Firecracker spike (throwaway).
# Snapshots are VMM-version sensitive — pin everything. Fill ARCH from the chosen host.

# Firecracker release to pin (set to a real published tag before running).
export FC_VERSION="1.10.1"
# aarch64 (OCI BM.Standard.A1.160) or x86_64 (nested-virt box). Set from `uname -m`.
export FC_ARCH="$(uname -m)"

# Guest kernel: a minimal vmlinux matching the host arch + Firecracker's supported config.
export GUEST_KERNEL="vmlinux-6.1-${FC_ARCH}"
export GUEST_KERNEL_URL=""   # fill: a known-good Firecracker CI kernel or self-built

# Minimal rootfs: Alpine + a tiny init that starts the hello web app on :8080 with /health.
export ROOTFS="rootfs-alpine-hello.ext4"

# CPU template: choose to match the host vendor family so the class is host-portable.
#   x86 Intel: T2CL / T2S ; x86 AMD: T2A ; aarch64: "none" (Firecracker normalizes less here).
export CPU_TEMPLATE="none"

# Local scratch for snapshot files.
export SPIKE_WORK="${SPIKE_WORK:-/tmp/fc-m0-spike}"
export GUEST_PORT="8080"
export HEALTH_PATH="/health"

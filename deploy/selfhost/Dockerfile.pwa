FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94 AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build:selfhost

FROM caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
# Caddy listens on 8443. An executable with an effective file capability
# cannot start with all capabilities dropped on a normal Linux host.
RUN setcap -r /usr/bin/caddy && chown -R 1000:1000 /data /config
COPY --from=build /src/dist-selfhost/ /srv/
USER 1000:1000

ATO_HOST=ato.home.arpa
# Bind to the isolated guest's LAN address for access from other devices.
ATO_BIND_IP=127.0.0.1
ATO_HTTPS_PORT=443

# Set this to the dedicated Linux Runner user's ingress directory after creating it.
# ATO_RUNNER_INGRESS_DIR=/home/ato-runner/.local/share/ato-selfhost/ingress

# Sign-in and mail (see README). Files and host aliases go in compose.local.yaml.
# ATO_AUTH_METHODS=password,email_otp
# ATO_MAIL=smtp
# ATO_MAIL_SMTP_HOST=smtp.example.com
# ATO_MAIL_SMTP_PORT=587
# ATO_MAIL_SMTP_TLS=starttls
# ATO_MAIL_SMTP_USERNAME=relay
# ATO_MAIL_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# ATO_MAIL_FROM=ato@example.com

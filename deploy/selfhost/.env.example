ATO_HOST=ato.home.arpa
# Bind to the isolated guest's LAN address for access from other devices.
ATO_BIND_IP=127.0.0.1
ATO_HTTPS_PORT=443

# Set this to the dedicated Linux Runner user's ingress directory after creating it.
# ATO_RUNNER_INGRESS_DIR=/home/ato-runner/.local/share/ato-selfhost/ingress

# Sign-in and mail (see README). Files and host aliases go in compose.local.yaml.
# ATO_AUTH_METHODS=passkey,password,email_otp
# ATO_AUTH_AUTO_METHODS=
# ATO_MAIL=smtp
# ATO_MAIL_SMTP_HOST=smtp.example.com
# ATO_MAIL_SMTP_PORT=587
# ATO_MAIL_SMTP_TLS=starttls
# ATO_MAIL_SMTP_USERNAME=relay
# ATO_MAIL_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# ATO_MAIL_FROM=ato@example.com

# Sign in with the Tailscale identity of the device (see README).
# ATO_AUTH_METHODS=passkey,password,trusted_proxy
# ATO_AUTH_AUTO_METHODS=trusted_proxy
# COMPOSE_PROFILES=tailscale
# ATO_TRUSTED_PROXY_PROVIDER=tailscale
# ATO_TRUSTED_PROXY_VERIFY=tailscale_whois
# ATO_TRUSTED_PROXY_TAILSCALE_SOCKET=/run/ato-whois/whois.sock
# ATO_TAILSCALE_HOSTNAME=ato-selfhost
# TS_AUTHKEY=tskey-auth-REPLACE_ME

# ATO_TRUSTED_PROXY_VERIFY=header is refused by start.sh because a network
# client can forge that header.

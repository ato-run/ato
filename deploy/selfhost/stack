#!/bin/sh
set -eu
site=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
# Release inputs are checked into this copy of the distribution.
unset ATO_VALIDATOR_REV
# shellcheck disable=SC1091
. "$site/versions.env"
ATO_VALIDATOR_REV=${ATO_VALIDATOR_REV:-$ATO_RUNNER_REV}
# An operator-supplied certificate replaces Caddy's internal CA for every site.
if [ -s "$site/.tmp/tls/fullchain.pem" ] && [ -s "$site/.tmp/tls/privkey.pem" ]; then
  ATO_TLS='/run/ato-tls/fullchain.pem /run/ato-tls/privkey.pem'
else
  ATO_TLS=internal
fi
export ATO_API_REV ATO_PWA_REV ATO_RUNNER_REV ATO_VALIDATOR_REV ATO_TLS

# compose.local.yaml holds this host's own additions and is never replaced by
# an update of the distribution.
compose() {
  if [ -f "$site/compose.local.yaml" ]; then
    docker compose --project-directory "$site" --env-file "$site/.env" \
      -f "$site/compose.yaml" -f "$site/compose.local.yaml" "$@"
  else
    docker compose --project-directory "$site" --env-file "$site/.env" \
      -f "$site/compose.yaml" "$@"
  fi
}

# The validator must be inside the network namespace of the API container that
# is running now. A validator that is stopped, joined to a replaced API
# container, or older than the API's last start cannot reach the verification
# listener, and Docker reports it as running all the same.
validator_follows_api() {
  api=$(compose ps -q api) || return 0
  [ -n "$api" ] || return 0
  api_state=$(docker inspect -f '{{.State.Running}} {{.State.StartedAt}}' "$api") || return 0
  [ "${api_state%% *}" = true ] || return 0
  api_started=${api_state#* }
  validator=$(compose ps -aq validator)
  if [ -n "$validator" ]; then
    state=$(docker inspect -f '{{.State.Running}} {{.HostConfig.NetworkMode}} {{.State.StartedAt}}' "$validator")
    running=${state%% *}
    rest=${state#* }
    joined=${rest%% *}
    started=${rest#* }
    if [ "$running" = true ] && [ "$joined" = "container:$api" ] &&
      LC_ALL=C expr "x$started" \> "x$api_started" >/dev/null; then
      return 0
    fi
  fi
  echo 'Recreating the validator inside the current API network namespace.' >&2
  compose up -d --no-deps --force-recreate --no-build --pull never validator
}

case "${1:-}" in
  up | start | restart)
    status=0
    compose "$@" || status=$?
    validator_follows_api
    exit "$status"
    ;;
esac
compose "$@"

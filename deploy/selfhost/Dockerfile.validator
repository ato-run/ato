FROM rust:1.96.0-bookworm@sha256:5e2214abe154fe26e39f64488952e5c991eeed1d6d6da7cc8381ae83927f0cfc AS build
WORKDIR /src
COPY . .
RUN cargo build --locked --release --bin ato-portable-validator

FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
COPY --from=build /src/target/release/ato-portable-validator /usr/local/bin/
USER 1000:1000
ENTRYPOINT ["/bin/sh", "-ec", "export CAPSULE_VALIDATOR_AGENT_TOKEN=\"$(cat /run/secrets/validator_token)\"; exec ato-portable-validator \"$@\"", "validator"]
